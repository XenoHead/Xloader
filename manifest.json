{
  "manifest_version": 3,
  "name": "Xloader",
  "version": "1.0.0",
  "description": "Records every download with its date/time, the link, and the site it actually came from. Right-click the icon and choose \"Check Xloads\".",
  "minimum_chrome_version": "116",
  "permissions": ["downloads", "storage", "contextMenus", "tabs"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Xloader — click to open Xloads",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
